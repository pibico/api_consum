# CONSUM-IA landing + server side — consum.pibico.es → api_consum (:8183)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name consum.pibico.es;

    ssl_certificate     /etc/letsencrypt/live/consum.pibico.es/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/consum.pibico.es/privkey.pem;


    # ── Mi PLC: CM4 local-webui via api_edge's ssh -L forward ─────────────
    # Pattern 1:1 from api_edge/nginx_tunnel_locations.conf (/webui/<port>/),
    # with the FAMILY gate: auth_request → api_consum /api/v1/plc/auth
    # (member + pro + the port must be the caller's own gateway).
    location ~ ^/plc/(\d+)(/.*)?$ {
        auth_request /_plc_auth;
        set $plc_port $1;
        set $plc_rest $2;
        if ($plc_rest = '') { set $plc_rest '/'; }

        # Self-heal: dead forward → 502/504 → re-ensure via api_consum→api_edge
        error_page 502 504 = @plc_heal;

        proxy_pass http://127.0.0.1:$plc_port$plc_rest$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /plc/$plc_port;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_connect_timeout 20;
        proxy_buffering off;
    }

    location @plc_heal {
        auth_request /_plc_ensure;

        proxy_pass http://127.0.0.1:$plc_port$plc_rest$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /plc/$plc_port;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_connect_timeout 60;
        proxy_buffering off;
    }

    location = /_plc_auth {
        internal;
        proxy_pass http://127.0.0.1:8183/api/v1/plc/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Webui-Port $plc_port;
        # CRITICAL: the embedded webui sends its own device Bearer token —
        # it must NOT shadow the SSO cookie in api_consum's validation.
        proxy_set_header Authorization "";
        proxy_set_header X-API-Key "";
    }

    location = /_plc_ensure {
        internal;
        proxy_pass http://127.0.0.1:8183/api/v1/plc/ensure;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Webui-Port $plc_port;
        proxy_set_header Authorization "";
        proxy_set_header X-API-Key "";
        proxy_read_timeout 30;
    }

    location / {
        proxy_pass http://127.0.0.1:8183;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name consum.pibico.es;
    return 301 https://$server_name$request_uri;
}
